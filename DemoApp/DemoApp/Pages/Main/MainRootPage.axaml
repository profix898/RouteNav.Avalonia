<routeNav:Page xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:routing="clr-namespace:RouteNav.Avalonia.Routing;assembly=RouteNav.Avalonia"
               xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
               mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
               Title="Home" Background="{DynamicResource DemoPageBackground}"
               x:Class="DemoApp.Pages.Main.MainRootPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,20" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Hero -->
            <StackPanel Spacing="6">
                <TextBlock Classes="PageTitle" Text="RouteNav.Avalonia" />
                <TextBlock Classes="PageSubtitle" MaxWidth="640" HorizontalAlignment="Left"
                           Text="URI-based navigation for Avalonia — a code-first, modular navigation system with page and dialog primitives." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Border Classes="Badge"><TextBlock Text="Avalonia 12" /></Border>
                    <Border Classes="Badge"><TextBlock Text=".NET 10" /></Border>
                    <Border Classes="Badge"><TextBlock Text="MIT" /></Border>
                </StackPanel>
            </StackPanel>

            <!-- Theme toggle -->
            <Border Classes="Card">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Appearance" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Classes="Hint" VerticalAlignment="Center"
                               Text="RouteNav's controls and this demo adapt to the theme variant." />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Content="Light" Click="OnThemeLight" />
                        <Button Content="Dark" Click="OnThemeDark" />
                        <Button Content="System" Click="OnThemeSystem" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Intro hint -->
            <Border Classes="HintCard">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Where to start" />
                    <TextBlock Text="This is the Main stack — a NavigationPageStack with a navigation bar and back button. The pages below cover dialogs, links, content composition, navigation targets, and theme/error states." />
                </StackPanel>
            </Border>

            <!-- Main stack pages -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="Explore the Main stack" />
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <routing:RouteButton Grid.Row="0" Grid.Column="0" RoutePath="/main/dialogs" Content="Dialogs and errors" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="Modal / embedded / overlay dialogs, message &amp; error dialogs, page-as-dialog, and built-in error pages." />
                        <routing:RouteButton Grid.Row="1" Grid.Column="0" RoutePath="/main/links" Content="Links and direct nav" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="Hyperlink controls (internal routes and external URIs) plus direct page/dialog pushing without a route." />
                        <routing:RouteButton Grid.Row="2" Grid.Column="0" RoutePath="/main/content" Content="Content composition" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="A page can host any Avalonia control — pages are just content." />
                        <routing:RouteButton Grid.Row="3" Grid.Column="0" RoutePath="/main/targets" Content="Navigation targets" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="Compare Self, Parent, Dialog, Overlay, and Window route targets." />
                        <routing:RouteButton Grid.Row="4" Grid.Column="0" RoutePath="/main/theming" Content="Theme and error states" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="Dark-mode readability plus improved built-in error pages." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Router playground -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionTitle" Text="Try the router" />
                    <TextBlock Classes="Hint"
                               Text="RouteNav navigates by URI. Type a route and press Go — this calls Navigation.PushAsync(uri)." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="RouteInput" Text="/main/links" Width="320" PlaceholderText="/stack/path?query" />
                        <Button Classes="Accent" Content="Go" Click="OnRouteGo" />
                    </StackPanel>
                    <TextBlock Classes="Hint"
                               Text="Try /main/dialogs, /main/content, /main/targets, /sidebar/page1 or /tabbed/page2 — or an unknown path like /main/nope to see the built-in 404 page." />
                </StackPanel>
            </Border>

            <!-- Route parameters -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionTitle" Text="Route parameters" />
                    <TextBlock Classes="Hint"
                               Text="Query-string parameters are parsed into the target page's PageQuery dictionary and read back there." />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="name" Classes="Mono" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameInput" Text="Ada" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="count" Classes="Mono" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CountInput" Text="3" Width="220" HorizontalAlignment="Left" />
                    </Grid>
                    <Button Classes="Accent" Content="Send to Content page" Click="OnSendParams" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Feature map -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="Feature map" />
                    <TextBlock Classes="Hint" Text="Where each RouteNav feature is demonstrated in this app." />
                    <Grid ColumnDefinitions="260,*" RowSpacing="7"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="URI routing / deep links" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="Hint" Text="Try the router (above)" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Route parameters (PageQuery)" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Hint" Text="Route parameters (above) → Content composition" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dialogs (modal / embedded / overlay)" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="Hint" Text="Dialogs and errors" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Message &amp; built-in error pages" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="Hint" Text="Theme and error states" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Hyperlink controls &amp; direct push" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="Hint" Text="Links and direct navigation" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Navigation targets (Self / Parent / Window)" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="Hint" Text="Navigation targets" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Cross-stack navigation" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="Hint" Text="Sidebar &amp; Tabbed root pages" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Sidebar / DrawerPage layout" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Classes="Hint" Text="Sidebar demo (below)" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tabbed layout" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Classes="Hint" Text="Tabbed demo (below)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Alternative layouts -->
            <TextBlock Classes="SectionTitle" Margin="2,4,0,0" Text="Alternative navigation layouts" />
            <WrapPanel Orientation="Horizontal">
                <Border Classes="Card" Width="410" Margin="0,0,16,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock FontSize="22" Text="&#x2630;" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Classes="SectionTitle" Margin="0" Text="Sidebar / Drawer" />
                                <TextBlock Classes="Hint" Text="SidebarMenuPageStack" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="Hint" Text="A hamburger/drawer menu built on Avalonia 12's native DrawerPage. The menu can also link to other stacks and external URIs." />
                        <TextBlock Classes="Hint" Text="Opens in a new window on desktop; on mobile/browser (single-view) it replaces the current view instead." />
                        <routing:RouteButton RoutePath="/sidebar/" Target="Window" Classes="Accent" Content="Open Sidebar demo" />
                    </StackPanel>
                </Border>
                <Border Classes="Card" Width="410" Margin="0,0,16,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock FontSize="22" Text="&#x25A4;" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Classes="SectionTitle" Margin="0" Text="Tabbed" />
                                <TextBlock Classes="Hint" Text="TabbedPageStack" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="Hint" Text="A tabbed interface whose tabs are populated automatically from the pages registered on the stack." />
                        <TextBlock Classes="Hint" Text="Opens in a new window on desktop; on mobile/browser (single-view) it replaces the current view instead." />
                        <routing:RouteButton RoutePath="/tabbed/" Target="Window" Classes="Accent" Content="Open Tabbed demo" />
                    </StackPanel>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</routeNav:Page>