<routeNav:Page xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
               xmlns:routeCtrl="clr-namespace:RouteNav.Avalonia.Controls;assembly=RouteNav.Avalonia"
               xmlns:routing="clr-namespace:RouteNav.Avalonia.Routing;assembly=RouteNav.Avalonia"
               mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
               Title="Links and Direct Navigation" Background="{DynamicResource DemoPageBackground}"
               x:Class="DemoApp.Pages.Main.MainPage2">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,20" MaxWidth="900">

            <StackPanel Spacing="4">
                <TextBlock Classes="PageTitle" Text="Links and direct navigation" />
                <TextBlock Classes="PageSubtitle"
                           Text="Trigger routing from hyperlink controls, or push pages and dialogs directly onto a stack without going through a route URI." />
            </StackPanel>

            <!-- Hyperlinks -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionTitle" Text="Hyperlink controls" />
                    <TextBlock Classes="Hint" Text="Internal routes navigate the stack; external URIs are handed to the platform launcher (browser, mail, …)." />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <Border Classes="Badge"><TextBlock Text="HyperlinkButton" /></Border>
                            <routeCtrl:HyperlinkButton NavigateUri="https://www.avaloniaui.net/" Content="External link (avaloniaui.net)" />
                            <routeCtrl:HyperlinkButton RoutePath="/main/content" Content="Internal link (Content page)" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <Border Classes="Badge"><TextBlock Text="HyperlinkLabel" /></Border>
                            <routeCtrl:HyperlinkLabel NavigateUri="https://www.avaloniaui.net/">External link (avaloniaui.net)</routeCtrl:HyperlinkLabel>
                            <routeCtrl:HyperlinkLabel RoutePath="/main/content">Internal link (Content page)</routeCtrl:HyperlinkLabel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Direct navigation -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="Direct navigation (no route)" />
                    <TextBlock Classes="Hint" Text="Push a page (IPageNavigation) or dialog (IDialogNavigation) straight onto the stack — useful for dynamically created content that has no registered route." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="PushPageCommand" Content="Push a page" />
                        <Button Click="PushDialogCommand" Content="Push a dialog" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <routing:RouteButton RoutePath="/main/content" Classes="Accent" Content="Next: Content composition" />
        </StackPanel>
    </ScrollViewer>
</routeNav:Page>