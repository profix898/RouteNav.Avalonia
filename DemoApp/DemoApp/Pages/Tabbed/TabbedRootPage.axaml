<routeNav:Page xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
               xmlns:routing="clr-namespace:RouteNav.Avalonia.Routing;assembly=RouteNav.Avalonia"
               mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
               Title="Home" Background="{DynamicResource DemoPageBackground}"
               x:Class="DemoApp.Pages.Tabbed.TabbedRootPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,20" MaxWidth="900">
            <routing:RouteButton RoutePath="/main" Target="Parent" Content="← Main" MinWidth="0" Padding="10,4"
                                 HorizontalAlignment="Left" />
            <StackPanel Spacing="4">
                <TextBlock Classes="PageTitle" Text="Tabbed navigation" />
                <TextBlock Classes="PageSubtitle"
                           Text="This stack (TabbedPageStack) turns each registered page into a tab. The tab header comes from the page's Title." />
            </StackPanel>
            <Border Classes="HintCard">
                <TextBlock Text="Use the tabs above to switch pages. This 'Home' tab is the stack's root page." />
            </Border>
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="Jump to the Main stack" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <routing:RouteButton RoutePath="/main" Target="Parent" Content="Main home" />
                        <routing:RouteButton RoutePath="/main/dialogs" Target="Parent" Content="Main · Dialogs" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</routeNav:Page>