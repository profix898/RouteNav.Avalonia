<routeNav:Page xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
               mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="420"
               Title="Summary" Background="{DynamicResource DemoPageBackground}"
               x:Class="DemoApp.Pages.Tabbed.TabbedPage1">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,20" MaxWidth="900">
            <StackPanel Spacing="4">
                <TextBlock Classes="PageTitle" Text="Summary" />
                <TextBlock Classes="PageSubtitle" Text="This tab's header is taken from the page's Title property." />
            </StackPanel>
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionTitle" Text="Highlights" />
                    <TextBlock Classes="Hint" Text="Switching tabs keeps all pages alive, so each tab preserves its state." />
                    <ProgressBar Height="6" Value="72" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</routeNav:Page>