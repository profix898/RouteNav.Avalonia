<routeNav:Page xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
               mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480"
               Title="Settings" Background="{DynamicResource DemoPageBackground}"
               x:Class="DemoApp.Pages.SidebarMenu.SidebarMenuPage3">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,20" MaxWidth="900">
            <StackPanel Spacing="4">
                <TextBlock Classes="PageTitle" Text="Settings" />
                <TextBlock Classes="PageSubtitle" Text="Pages keep their own state while the drawer stays in place." />
            </StackPanel>
            <Border Classes="Card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="SectionTitle" Text="Preferences" />
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Email notifications" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" IsChecked="True" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Weekly digest" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Beta features" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" /></Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</routeNav:Page>