<routeNav:Page xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
               xmlns:routing="clr-namespace:RouteNav.Avalonia.Routing;assembly=RouteNav.Avalonia"
               mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
               Title="Home" Background="{DynamicResource DemoPageBackground}"
               x:Class="DemoApp.Pages.SidebarMenu.SidebarMenuRootPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,20" MaxWidth="900">
            <routing:RouteButton RoutePath="/main" Target="Parent" Content="← Main" MinWidth="0" Padding="10,4" HorizontalAlignment="Left" />
            <StackPanel Spacing="4">
                <TextBlock Classes="PageTitle" Text="Sidebar / Drawer navigation" />
                <TextBlock Classes="PageSubtitle"
                           Text="This stack (SidebarMenuPageStack) is composed on Avalonia 12's native DrawerPage. Open the menu (☰) to switch pages." />
            </StackPanel>
            <Border Classes="HintCard">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Menu items can cross stacks" />
                    <TextBlock Text="The drawer includes a link to a page on the Tabbed stack, and menu items can also target external URIs — without leaving the current stack." />
                </StackPanel>
            </Border>
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="Drawer display mode" />
                    <TextBlock Classes="Hint"
                               Text="Switch the native DrawerPage's display mode at runtime. Auto adapts to the window width; try resizing the window." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Auto" Tag="Auto" Click="OnDisplayMode" />
                        <Button Content="Inline" Tag="Inline" Click="OnDisplayMode" />
                        <Button Content="Overlay" Tag="Overlay" Click="OnDisplayMode" />
                        <Button Content="Compact" Tag="CompactOverlay" Click="OnDisplayMode" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="Jump to the Main stack" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <routing:RouteButton RoutePath="/main" Target="Parent" Content="Main home" />
                        <routing:RouteButton RoutePath="/main/page2" Target="Parent" Content="Main · Links" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</routeNav:Page>