<routeNav:Window xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:routeNav="clr-namespace:RouteNav.Avalonia;assembly=RouteNav.Avalonia"
                 xmlns:routing="clr-namespace:RouteNav.Avalonia.Routing;assembly=RouteNav.Avalonia"
                 x:Class="DemoApp.SidebarWindow"
                 Background="{DynamicResource DemoPageBackground}"
                 Title="Custom Shell"
                 MinWidth="640" MinHeight="480">

    <!-- Custom window chrome: a toolbar above the navigation surface (normal OS window frame) -->
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource DemoAccentSoftBrush}"
                Padding="14,8" BorderBrush="{DynamicResource DemoCardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="&#9670;" Foreground="{DynamicResource DemoAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Custom window shell" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <routing:RouteButton RoutePath="/sidebar/" Classes="Accent" Content="Home" />
                    <routing:RouteButton RoutePath="/sidebar/page2" Content="Reports" />
                    <routing:RouteButton RoutePath="/sidebar/page3" Content="Settings" />
                </StackPanel>

                <TextBlock Grid.Column="2" Classes="Hint" Margin="14,0,0,0"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=routeNav:Window}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="3" x:Name="BackButton" Content="&#8592; Back" VerticalAlignment="Center"
                        Click="OnBack" />
            </Grid>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</routeNav:Window>