<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RouteNav.Avalonia.Controls">
    <Design.PreviewWith>
        <Border Width="400" Height="200">
            <controls:SidebarMenu>
                <controls:SidebarMenuItem Text="Item1" />
                <controls:SidebarMenuItem Text="Item2" />
            </controls:SidebarMenu>
        </Border>
    </Design.PreviewWith>

    <!--
        SidebarMenu composes the native Avalonia 12 DrawerPage. The DrawerPage picks up the standard
        Fluent drawer theming, which consumers can override the usual way (control theme / resource
        keys). RouteNav only injects the menu list and forwards its own header/footer/content.
    -->
    <ControlTheme x:Key="{x:Type controls:SidebarMenu}" TargetType="controls:SidebarMenu">
        <Setter Property="Template">
            <ControlTemplate>
                <DrawerPage x:Name="PART_Drawer"
                            DrawerHeader="{TemplateBinding SidebarHeader}"
                            DrawerFooter="{TemplateBinding SidebarFooter}"
                            Content="{TemplateBinding Page}">
                    <DrawerPage.Drawer>
                        <ListBox x:Name="PART_MenuItemList"
                                 Background="Transparent"
                                 HorizontalAlignment="Stretch">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </DrawerPage.Drawer>
                </DrawerPage>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>