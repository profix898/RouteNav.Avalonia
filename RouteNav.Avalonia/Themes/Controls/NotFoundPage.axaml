<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:RouteNav.Avalonia.Pages">
    <Design.PreviewWith>
        <Border Padding="50">
            <pages:NotFoundPage />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type pages:NotFoundPage}" TargetType="pages:NotFoundPage">
        <Setter Property="Title" Value="Page Not Found" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                       Background="{DynamicResource PageBackground}">
                    <Border Background="{DynamicResource ErrorPageCardBackground}"
                            BorderBrush="{DynamicResource ErrorPageCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{DynamicResource ErrorPageCardBorderBrush}"
                                        CornerRadius="999"
                                        Width="48"
                                        Height="48"
                                        VerticalAlignment="Center">
                                    <PathIcon
                                        Data="M10,2 A8,8 0 1 1 10,18 A8,8 0 1 1 10,2 M10,5.5 L10,11 M10,14 L10,15"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource ErrorPageMutedForeground}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="404"
                                           Foreground="{DynamicResource NotFoundErrorTextColor}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Page not found" Foreground="{DynamicResource PageForeground}"
                                       FontSize="24" FontWeight="Bold" />
                            <TextBlock
                                Text="The route could not be resolved by the current navigation stack. Check the URI, stack name, or registered route."
                                Foreground="{DynamicResource ErrorPageMutedForeground}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>